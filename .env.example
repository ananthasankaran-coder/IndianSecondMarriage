# Copy to .env.local for local development. NEVER commit real values. Never put real user data in lower environments.
APP_ENV=local                              # local | development | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000  # must be https in production

# Supabase (from your project's Settings -> API). The service role key is SERVER-ONLY and extremely powerful.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Use the Supabase *transaction pooler* connection string in serverless environments.
DATABASE_URL=

# Secures the background-job endpoint. Generate: openssl rand -hex 32  (>= 32 characters)
CRON_SECRET=

# Decision D1. Leave EMPTY until legal approval: production then keeps registration CLOSED.
# Local/dev/staging default to 18 when empty.
REGISTRATION_MIN_AGE=

# AI (all AI flags default OFF; see decision D12). Server-side only.
GEMINI_API_KEY=
